# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# kiosk visitor captures (admin-only, not in git)
/data/kiosk-captures/

# generated PWA / offline assets
/public/sw.js
/public/kiosk-offline-data.json
/public/kiosk-citizens-charter.json
/public/kiosk-precache-routes.json

# Ubuntu kiosk deploy scripts (local / USB only — do not commit)
/deploy/kiosk-device/
.env.kiosk.example
