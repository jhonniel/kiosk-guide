generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id])
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  module      String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Service {
  id              String   @id @default(cuid())
  slug            String   @unique
  titleEn         String
  titleFil        String
  titleBis        String?
  descriptionEn   String
  descriptionFil  String
  descriptionBis  String?
  requirementsEn  String?
  requirementsFil String?
  requirementsBis String?
  documentsEn     String?
  documentsFil    String?
  documentsBis    String?
  officeLocation  String?
  officeHours     String?
  processingTime  String?
  fee             String?
  contactInfo     String?
  category        String?
  icon            String?
  color           String?
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Directory {
  id             String   @id @default(cuid())
  type           String
  nameEn         String
  nameFil        String
  nameBis        String?
  descriptionEn  String?
  descriptionFil String?
  descriptionBis String?
  floor          String?
  room           String?
  building       String?
  department     String?
  headName       String?
  contactNumber  String?
  email          String?
  officeHours    String?
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Download {
  id             String          @id @default(cuid())
  titleEn        String
  titleFil       String
  titleBis       String?
  descriptionEn  String?
  descriptionFil String?
  descriptionBis String?
  fileUrl        String
  fileName       String
  fileSize       String?
  category       String?
  isActive       Boolean         @default(true)
  sortOrder      Int             @default(0)
  downloadCount  Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  tokens         DownloadToken[]
  activities     DownloadActivity[]
}

model DownloadToken {
  id             String   @id @default(cuid())
  token          String   @unique
  downloadId     String
  download       Download @relation(fields: [downloadId], references: [id], onDelete: Cascade)
  method         String   @default("qr")
  recipientEmail String?
  expiresAt      DateTime
  accessCount    Int      @default(0)
  createdAt      DateTime @default(now())
  activities     DownloadActivity[]

  @@index([expiresAt])
  @@index([downloadId])
}

enum DownloadActivityType {
  QR_GENERATED
  QR_SCANNED
  EMAIL_SENT
}

model DownloadActivity {
  id             String               @id @default(cuid())
  downloadId     String
  download       Download             @relation(fields: [downloadId], references: [id], onDelete: Cascade)
  tokenId        String?
  token          DownloadToken?       @relation(fields: [tokenId], references: [id], onDelete: SetNull)
  type           DownloadActivityType
  recipientEmail String?
  createdAt      DateTime             @default(now())

  @@index([downloadId, createdAt])
  @@index([type, createdAt])
}

model Faq {
  id             String   @id @default(cuid())
  questionEn     String
  questionFil    String
  questionBis    String?
  answerEn       String
  answerFil      String
  answerBis      String?
  category       String?
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Announcement {
  id             String   @id @default(cuid())
  titleEn        String
  titleFil       String
  titleBis       String?
  contentEn      String
  contentFil     String
  contentBis     String?
  imageUrl       String?
  category       String?
  isPublished    Boolean  @default(true)
  publishedAt    DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Tourism {
  id             String   @id @default(cuid())
  titleEn        String
  titleFil       String
  titleBis       String?
  descriptionEn  String
  descriptionFil String
  descriptionBis String?
  location       String?
  imageUrl       String?
  category       String?
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model EmergencyContact {
  id             String   @id @default(cuid())
  nameEn         String
  nameFil        String
  nameBis        String?
  phoneNumber    String
  descriptionEn  String?
  descriptionFil String?
  descriptionBis String?
  category       String?
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Event {
  id             String   @id @default(cuid())
  titleEn        String
  titleFil       String
  titleBis       String?
  descriptionEn  String
  descriptionFil String
  descriptionBis String?
  location       String?
  startDate      DateTime
  endDate        DateTime?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Feedback {
  id        String   @id @default(cuid())
  name      String?
  email     String?
  rating    Int?
  message   String
  category  String?
  createdAt DateTime @default(now())
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  group     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VisitorLog {
  id        String   @id @default(cuid())
  page      String
  sessionId String?
  language  String?
  createdAt DateTime @default(now())
}

model SearchLog {
  id        String   @id @default(cuid())
  query     String
  results   Int      @default(0)
  sessionId String?
  createdAt DateTime @default(now())
}

model QuickLink {
  id             String   @id @default(cuid())
  slug           String   @unique
  titleEn        String
  titleFil       String
  titleBis       String?
  icon           String
  href           String
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Page {
  id             String   @id @default(cuid())
  slug           String   @unique
  titleEn        String
  titleFil       String
  titleBis       String?
  contentEn      String
  contentFil     String
  contentBis     String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model HomepageCard {
  id             String   @id @default(cuid())
  slug           String   @unique
  titleEn        String
  titleFil       String
  titleBis       String?
  descriptionEn  String
  descriptionFil String
  descriptionBis String?
  icon           String
  iconUrl        String?
  color          String
  href           String
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model BuildingLocation {
  id              String   @id @default(cuid())
  buildingNameEn  String
  buildingNameFil String?
  buildingNameBis String?
  nameEn          String
  nameFil         String?
  nameBis         String?
  floor           Int
  floorLabelEn    String
  floorLabelFil   String?
  floorLabelBis   String?
  room            String?
  locationType    String
  category        String?
  nearbyLandmarks String
  directionsEn    String
  directionsFil   String?
  directionsBis   String?
  aliases         String?
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum CharterEditionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model CharterEdition {
  id          String               @id @default(cuid())
  title       String
  year        Int                  @default(2026)
  editionLabel String              @default("1st Edition")
  description String?
  pdfUrl      String               @default("/downloads/citizens-charter.pdf")
  pdfFileName String               @default("citizens-charter.pdf")
  status      CharterEditionStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  offices     CharterOffice[]

  @@index([status])
}

model CharterOffice {
  id        String            @id @default(cuid())
  editionId String
  edition   CharterEdition    @relation(fields: [editionId], references: [id], onDelete: Cascade)
  name      String
  isActive  Boolean           @default(true)
  sortOrder Int               @default(0)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  categories CharterCategory[]

  @@index([editionId, sortOrder])
}

model CharterCategory {
  id        String          @id @default(cuid())
  officeId  String
  office    CharterOffice   @relation(fields: [officeId], references: [id], onDelete: Cascade)
  name      String
  isActive  Boolean         @default(true)
  sortOrder Int             @default(0)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  services  CharterService[]

  @@index([officeId, sortOrder])
}

model CharterService {
  id                 String               @id @default(cuid())
  categoryId         String
  category           CharterCategory      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name               String
  pageNumber         Int?
  description        String?
  officeOrDivision   String?
  classification     String?
  typeOfTransaction  String?
  whoMayAvail        String?
  detailsJson        String?
  isActive           Boolean              @default(true)
  sortOrder          Int                  @default(0)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  requirements       CharterRequirement[]
  steps              CharterStep[]
  medicines          CharterMedicine[]

  @@index([categoryId, sortOrder])
}

model CharterRequirement {
  id            String         @id @default(cuid())
  serviceId     String
  service       CharterService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  requirement   String
  whereToSecure String         @default("")
  isSection     Boolean        @default(false)
  isActive      Boolean        @default(true)
  sortOrder     Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([serviceId, sortOrder])
}

model CharterStep {
  id        String         @id @default(cuid())
  serviceId String
  service   CharterService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  step      String         @default("")
  action    String         @default("")
  fee       String         @default("")
  time      String         @default("")
  person    String         @default("")
  isActive  Boolean        @default(true)
  sortOrder Int            @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([serviceId, sortOrder])
}

model CharterMedicine {
  id           String         @id @default(cuid())
  serviceId    String
  service      CharterService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  name         String
  preparation  String         @default("")
  brand        String         @default("")
  price        String         @default("")
  isSection    Boolean        @default(false)
  isActive     Boolean        @default(true)
  sortOrder    Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([serviceId, sortOrder])
}

// ---------- Interactive Map Engine (vector / data-driven) ----------

model MapMunicipality {
  id          String          @id @default(cuid())
  slug        String          @unique
  nameEn      String
  nameFil     String
  nameBis     String?
  description String?
  svgPath     String
  labelX      Float
  labelY      Float
  fillColor   String          @default("#d8efe6")
  sortOrder   Int             @default(0)
  attractions MapAttraction[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model MapCategory {
  id            String          @id @default(cuid())
  slug          String          @unique
  nameEn        String
  nameFil       String
  nameBis       String?
  color         String
  icon          String?
  sortOrder     Int             @default(0)
  showInFilter  Boolean         @default(true)
  showInLegend  Boolean         @default(true)
  attractions   MapAttraction[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model MapAttraction {
  id              String           @id @default(cuid())
  slug            String           @unique
  nameEn          String
  nameFil         String
  nameBis         String?
  descriptionEn   String
  descriptionFil  String
  descriptionBis  String?
  historyEn       String?
  historyFil      String?
  historyBis      String?
  categoryId      String
  category        MapCategory      @relation(fields: [categoryId], references: [id])
  municipalityId  String?
  municipality    MapMunicipality? @relation(fields: [municipalityId], references: [id])
  latitude        Float
  longitude       Float
  mapX            Float
  mapY            Float
  svgPath         String?
  coverImage      String?
  entranceFeeEn   String?
  entranceFeeFil  String?
  entranceFeeBis  String?
  openingHoursEn  String?
  openingHoursFil String?
  openingHoursBis String?
  rating          Float            @default(4.5)
  website         String?
  phone           String?
  travelTipsEn             String?
  travelTipsFil            String?
  travelTipsBis            String?
  travelTimeEn             String?
  travelTimeFil            String?
  travelTimeBis            String?
  distanceFromCapitolEn    String?
  distanceFromCapitolFil   String?
  distanceFromCapitolBis   String?
  labelText                String?
  labelDx                  Float?
  labelDy                  Float?
  labelSide                String?
  featured                 Boolean          @default(false)
  isActive                 Boolean          @default(true)
  sortOrder                Int              @default(0)
  photos                   MapPhoto[]
  reviews                  MapReview[]
  favorites                MapFavorite[]
  routeStarts              MapRoute[]       @relation("RouteFrom")
  routeEnds                MapRoute[]       @relation("RouteTo")
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  @@index([categoryId])
  @@index([municipalityId])
  @@index([isActive, sortOrder])
}

model MapPhoto {
  id           String        @id @default(cuid())
  attractionId String
  attraction   MapAttraction @relation(fields: [attractionId], references: [id], onDelete: Cascade)
  url          String
  caption      String?
  sortOrder    Int           @default(0)
  createdAt    DateTime      @default(now())

  @@index([attractionId, sortOrder])
}

model MapRoute {
  id            String        @id @default(cuid())
  slug          String        @unique
  nameEn        String
  nameFil       String
  nameBis       String?
  kind          String
  fromId        String
  toId          String
  from          MapAttraction @relation("RouteFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to            MapAttraction @relation("RouteTo", fields: [toId], references: [id], onDelete: Cascade)
  pointsJson    String
  travelTimeEn  String?
  travelTimeFil String?
  travelTimeBis String?
  distanceKm    Float?
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([fromId])
  @@index([toId])
}

model MapFeature {
  id        String   @id @default(cuid())
  slug      String   @unique
  kind      String
  nameEn    String?
  nameFil   String?
  nameBis   String?
  svgPath   String
  fill      String?
  stroke    String?
  zIndex    Int      @default(0)
  animated  Boolean  @default(false)
  metaJson  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind, zIndex])
}

model MapReview {
  id           String        @id @default(cuid())
  attractionId String
  attraction   MapAttraction @relation(fields: [attractionId], references: [id], onDelete: Cascade)
  author       String?
  rating       Int
  comment      String?
  createdAt    DateTime      @default(now())

  @@index([attractionId])
}

model MapFavorite {
  id           String        @id @default(cuid())
  attractionId String
  attraction   MapAttraction @relation(fields: [attractionId], references: [id], onDelete: Cascade)
  sessionId    String
  createdAt    DateTime      @default(now())

  @@unique([attractionId, sessionId])
  @@index([sessionId])
}

model MapAnnotation {
  id                   String   @id @default(cuid())
  slug                 String   @unique
  text                 String
  kind                 String
  mapX                 Float
  mapY                 Float
  fontSize             Float?
  anchor               String?
  infoEn               String?
  infoFil              String?
  infoBis              String?
  skipIfAttractionSlug String?
  isActive             Boolean  @default(true)
  sortOrder            Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@index([kind])
}

model MapRestaurant {
  id              String   @id @default(cuid())
  slug            String   @unique
  nameEn          String
  nameFil         String
  nameBis         String?
  description     String?
  descriptionEn   String?
  descriptionFil  String?
  descriptionBis  String?
  coverImage      String?
  phone           String?
  website         String?
  openingHoursEn  String?
  openingHoursFil String?
  openingHoursBis String?
  addressEn       String?
  mapX            Float
  mapY            Float
  rating          Float    @default(4)
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model MapHotel {
  id              String   @id @default(cuid())
  slug            String   @unique
  nameEn          String
  nameFil         String
  nameBis         String?
  description     String?
  descriptionEn   String?
  descriptionFil  String?
  descriptionBis  String?
  coverImage      String?
  phone           String?
  website         String?
  openingHoursEn  String?
  openingHoursFil String?
  openingHoursBis String?
  addressEn       String?
  mapX            Float
  mapY            Float
  rating          Float    @default(4)
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
