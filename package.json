{
  "name": "kiosk-guide",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run offline:generate && next dev -H 0.0.0.0 -p 3000",
    "dev:turbo": "next dev --turbopack -H 0.0.0.0 -p 3000",
    "dev:clean": "lsof -ti:3000 | xargs kill -9 2>/dev/null || true; rm -rf .next && next dev -H 0.0.0.0 -p 3000",
    "dev:clean:turbo": "lsof -ti:3000 | xargs kill -9 2>/dev/null || true; rm -rf .next && next dev --turbopack -H 0.0.0.0 -p 3000",
    "build": "npm run offline:generate && next build",
    "offline:generate": "tsx scripts/generate-offline-data.ts",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "eslint",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1083.0",
    "@base-ui/react": "^1.6.0",
    "@hookform/resolvers": "^5.4.0",
    "@prisma/client": "^6.19.3",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@serwist/next": "^9.5.11",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^12.42.2",
    "gsap": "^3.15.0",
    "lucide-react": "^1.23.0",
    "next": "15.5.20",
    "next-auth": "^5.0.0-beta.31",
    "next-themes": "^0.4.6",
    "nodemailer": "^7.0.13",
    "prisma": "^6.19.3",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.80.0",
    "react-zoom-pan-pinch": "^4.0.3",
    "serwist": "^9.5.11",
    "shadcn": "^4.12.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@serwist/cli": "^9.5.11",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/gsap": "^1.20.2",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.0",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "15.5.20",
    "tailwindcss": "^4",
    "tsx": "^4.22.5",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
